#!/usr/bin/fish

# fetch submodules
git submodule update --init
git submodule update --remote

# setup base configuration
if test -z "$XDG_CONFIG_HOME"
	set -x XDG_CONFIG_HOME $HOME/.config
end
rm -rf $XDG_CONFIG_HOME/nvim $XDG_CONFIG_HOME/fish $XDG_CONFIG_HOME/tmux
cp -Rf .config/* $XDG_CONFIG_HOME

# setup vim configuration
rm -rf $HOME/.vim $HOME/.vimrc
mkdir -p $HOME/.vim
ln -sf $XDG_CONFIG_HOME/nvim/init.vim $HOME/.vimrc
ln -sf $XDG_CONFIG_HOME/nvim/autoload $HOME/.vim/autoload
ln -sf $XDG_CONFIG_HOME/nvim/bundle   $HOME/.vim/bundle

# setup fish configuration
wget -O $XDG_CONFIG_HOME/fish/conf.d/fzf.fish     https://raw.githubusercontent.com/junegunn/fzf/master/shell/key-bindings.fish
wget -O $XDG_CONFIG_HOME/fish/conf.d/dracula.fish https://raw.githubusercontent.com/dracula/fish/master/dracula.fish

# setup bash configuration
wget -O $XDG_CONFIG_HOME/bash/conf.d/fzf.bash     https://raw.githubusercontent.com/junegunn/fzf/master/shell/key-bindings.bash
cat .bashrc >> $HOME/.bashrc
if test -n "$BASH"
	bash -c 'source $HOME/.bashrc'
end

# setup tmux configuration
rm -rf $HOME/.tmux.conf
ln -sf $XDG_CONFIG_HOME/tmux/tmux.conf $HOME/.tmux.conf
if test -n "$TMUX"
	tmux source $XDG_CONFIG_HOME/tmux/tmux.conf
end
