#!/bin/sh

git submodule update --init
git submodule update --remote

cp	-Rf	.config					~/
mkdir	-p	~/.vim
ln	-sf	~/.config/nvim/init.vim			~/.vimrc
ln	-sf	~/.config/nvim/autoload			~/.vim/autoload
ln	-sf	~/.config/nvim/bundle			~/.vim/bundle

cp	-Rf	.tmux					~/
cp	-f	.tmux.conf				~/
cp	-f	.promptline.conf			~/
cp	-f	.tmuxline.conf				~/

wget	-O	~/.fzf.conf				https://raw.githubusercontent.com/junegunn/fzf/master/shell/key-bindings.bash
wget	-O	~/.config/fish/conf.d/fzf.fish		https://raw.githubusercontent.com/junegunn/fzf/master/shell/key-bindings.fish
wget	-O	~/.config/fish/conf.d/dracula.fish	https://raw.githubusercontent.com/dracula/fish/master/dracula.fish
mkdir	-p	~/.config/fish/completions
cp	-Rf	.config/fish/completions		~/.config/fish/completions

cat	.bashrc	>>					~/.bashrc
source	~/.bashrc
