#!/usr/bin/env fish

function __has
    for var in $argv
        if not type -q $var
            echo "error: $var not found"
            exit 1
        else
            echo "info: $var found"
        end
    end
end

function __run_int
    $argv
    if test $status -ne 0
        echo "error: $argv[1] failed"
        exit 1
    end
end

function __run_cmd
    command $argv
    if test $status -ne 0
        echo "error: $argv[1] failed"
        exit 1
    end
end

function __check_pipe
    for var in $pipestatus
        if test $var -ne 0
            echo "error: pipe failed"
            status --print-stack-trace
            exit 1
        end
    end
end

function setup__starship
    echo "info: starship setup begin"
    if not type -q starship
        echo "info: starship not found"
        curl --fail --no-progress-meter --location https://raw.githubusercontent.com/starship/starship/refs/heads/master/install/install.sh | sh -s -- --yes --bin-dir $HOME/.local/bin
        __check_pipe
    end

    if test -f $HOME/.config/starship.toml
        echo "info: starship setup clean"
        __run_cmd rm -f $HOME/.config/starship.toml
    end

    echo "info: starship install config"
    __run_cmd stow --no-folding --target $HOME starship

    echo "info: starship setup end"
end

function setup__fish
    echo "info: fish setup begin"
    if test -d $HOME/.config/fish
        if not test -w $HOME/.config/fish
            echo "error: fish setup failed"
            status --print-stack-trace
            exit 1
        end
        echo "info: fish setup clean"
        __run_cmd rm -rf $HOME/.config/fish
    end

    echo "info: fish install config"
    __run_cmd stow --no-folding --target $HOME fish

    echo "info: fish install plugins"
    curl --fail --no-progress-meter --location https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
    __check_pipe
    __run_int fisher install jorgebucaran/fisher
    __run_int fisher install PatrickF1/fzf.fish
    __run_int fisher install dracula/fish
    __run_int fish_config theme choose "Dracula Official"
    __run_int fish_config theme save
    if set --query FZF_DEFAULT_OPTS
        __run_int set --erase FZF_DEFAULT_OPTS
    end
    # from https://draculatheme.com/fzf
    __run_int set --universal --export FZF_DEFAULT_OPTS "--color=fg:#f8f8f2,bg:#282a36,hl:#bd93f9 --color=fg+:#f8f8f2,bg+:#44475a,hl+:#bd93f9 --color=info:#ffb86c,prompt:#50fa7b,pointer:#ff79c6 --color=marker:#ff79c6,spinner:#ffb86c,header:#6272a4"

    if test -d $HOME/.local/bin
        __run_int set --universal fish_user_paths $HOME/.local/bin $fish_user_paths
    end

    echo "info: fish setup end"
end

function setup__tmux
    echo "info: tmux setup begin"
    if test -f $HOME/.tmux.conf -o -d $HOME/.tmux
        echo "info: tmux setup clean"
        __run_cmd rm -f $HOME/.tmux.conf
        __run_cmd rm -rf $HOME/.tmux
    end

    echo "info: tmux install config"
    __run_cmd stow --no-folding --target $HOME tmux

    echo "info: tmux install plugins"
    __run_cmd git clone https://github.com/tmux-plugins/tpm $HOME/.tmux/plugins/tpm
    __run_cmd sh $HOME/.tmux/plugins/tpm/scripts/install_plugins.sh

    echo "info: tmux setup end"
end

function setup__nvim
    echo "info: nvim setup begin"
    if test -d $HOME/.config/nvim
        echo "info: nvim setup clean"
        __run_cmd rm -rf $HOME/.config/nvim
        __run_cmd rm -rf $HOME/.local/share/nvim
        __run_cmd rm -rf $HOME/.local/state/nvim
        __run_cmd rm -rf $HOME/.cache/nvim
    end

    echo "info: nvim install config"
    __run_cmd stow --no-folding --target $HOME nvim

    # FIXME: Use the delay as a hack to wait for some deferred, asynchronous
    # plugin setups, such as those handled by mason and treesitter, which Lazy
    # does not otherwise wait for
    echo "info: nvim install plugins"
    __run_cmd nvim --headless "+Lazy install" "+MasonUpdate" "+sleep 10" "+qall"

    # Add a newline since nvim output may not always end with one
    echo
    echo "note: nvim setup may be deferred"

    echo "info: nvim setup end"
end

__has fish curl stow fzf tmux nvim unzip
setup__starship
setup__fish
setup__tmux
setup__nvim
